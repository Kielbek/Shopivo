<section class="catalog section" id="{{ section.settings.anchor | default: 'catalog' }}" data-catalog>
<div class="wrap">
<div class="catalog-header">
<h2{{ section | edit: 'heading' }}>{{ section.settings.heading }}</h2>
<div class="filters" aria-label="Kategorie">
<button class="filter active" type="button" data-cat="" aria-pressed="true"{{ section | edit: 'all_label' }}>{{ section.settings.all_label }}</button>
{%- for c in section.settings.categories %}<button class="filter" type="button" data-cat="{{ c.slug }}" aria-pressed="false">{{ c.name }}</button>{% endfor %}
</div>
</div>
<div class="product-grid" data-cat-panel="">
{%- for product in section.settings.products.items %}{% render 'product-card', product: product %}{% else %}<p class="empty">Brak produktów spełniających kryteria.</p>{% endfor -%}
</div>
{%- for c in section.settings.categories %}
<div class="product-grid" data-cat-panel="{{ c.slug }}" hidden>
{%- for product in c.items %}{% render 'product-card', product: product %}{% else %}<p class="empty">Brak produktów spełniających kryteria.</p>{% endfor -%}
</div>
{%- endfor %}
{%- if section.settings.button_label != blank %}
<div class="more"><a class="pill" href="/produkty" data-cat-more><span{{ section | edit: 'button_label' }}>{{ section.settings.button_label }}</span> <span aria-hidden="true">↗</span></a></div>
{%- endif %}
</div>
</section>

{% schema %}
{
  "name": "Katalog z kategoriami",
  "settings": [
    { "id": "heading", "type": "text", "label": "Nagłówek", "default": "WSZYSTKIE MEBLE", "max": 60 },
    { "id": "all_label", "type": "text", "label": "Nazwa przycisku wszystkich produktów", "default": "Wszystkie", "max": 20 },
    { "id": "categories", "type": "category_list", "label": "Kategorie w filtrze", "default": { "mode": "top" }, "products_per_category": 6 },
    { "id": "products", "type": "product_list", "label": "Produkty bez filtra", "default": { "source": "bestsellers", "count": 6 } },
    { "id": "button_label", "type": "text", "label": "Tekst przycisku", "default": "Zobacz wszystkie meble", "max": 40 },
    { "id": "anchor", "type": "text", "label": "Kotwica (do linków w menu)", "default": "catalog", "max": 30 }
  ]
}
{% endschema %}

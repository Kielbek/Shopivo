{%- comment -%} Product card of the design. Params: product, note (line under the name; default: the reduced price) {%- endcomment -%}
<article class="product"><div class="nd-photo-box"><a class="product-photo" href="{{ product.url }}">{% if product.image %}<img loading="lazy" decoding="async" src="{{ product.image | image_url: 'w400' }}" alt="{{ product.image.alt | default: product.name }}">{% else %}<span class="nd-placeholder">Zdjęcie wkrótce</span>{% endif %}</a><button class="heart" type="button" data-shop-fav="{{ product.id }}" aria-pressed="false" aria-label="Ulubione: {{ product.name }}">{% render 'icon', name: 'heart', px: 17 %}</button>{% if product.available %}<button class="add" type="button" data-shop-add data-product="{{ product.slug }}" aria-label="Dodaj do koszyka: {{ product.name }}">{% render 'icon', name: 'plus', px: 18 %}</button>{% endif %}</div><div class="product-info"><a href="{{ product.url }}">{{ product.name }}</a><span class="price">{% render 'price', product: product %}</span></div><div class="review">{% if product.on_sale %}<b>✳</b> Było {{ product.compare_at | money: product.currency | remove: ',00' }}{% elsif note %}<b>✳</b> {{ note }}{% elsif product.available == false %}Chwilowo niedostępny{% else %}{{ product.summary }}{% endif %}</div>{% render 'omnibus', product: product %}</article>

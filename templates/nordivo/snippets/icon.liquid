{%- comment -%} Line icons of the design. Params: name, px (default 21), fill (default none) {%- endcomment -%}
{%- assign s = px | default: 21 -%}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="{{ fill | default: 'none' }}" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- case name -%}
{%- when 'search' %}<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
{%- when 'heart' %}<path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.5a5.5 5.5 0 0 0 0-7.8Z"/>
{%- when 'cart' %}<path d="M2 3h3l2 12h12l2-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
{%- when 'user' %}<circle cx="12" cy="8" r="3.5"/><path d="M4 21v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2"/>
{%- when 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
{%- when 'plus' %}<path d="M12 5v14M5 12h14"/>
{%- when 'left' %}<path d="m15 6-6 6 6 6"/>
{%- when 'right' %}<path d="m9 6 6 6-6 6"/>
{%- when 'mail' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
{%- when 'arrow' %}<path d="M4 12h15m-6-6 6 6-6 6"/>
{%- endcase -%}
</svg>

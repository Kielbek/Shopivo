{%- comment -%} Breadcrumbs and heading of a shop page (design: "Strona główna / …", kicker, h1). Params: title, kicker, crumb, crumb_url {%- endcomment -%}
<nav class="breadcrumbs" aria-label="Ścieżka nawigacji"><a href="/">Strona główna</a>{% if crumb_url %}<span aria-hidden="true"> / </span><a href="{{ crumb_url }}">{{ crumb }}</a>{% endif %}<span aria-hidden="true"> / </span><span>{{ title }}</span></nav>
<div class="page-heading"><span class="eyebrow">{{ kicker | default: 'Twój sklep' }}</span><h1 tabindex="-1">{{ title }}</h1></div>

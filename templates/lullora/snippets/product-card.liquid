{%- comment -%} Product card of the design: photo, name, price, favourites and quick add. Param: product {%- endcomment -%}
<article class="product"><a class="photo-slot product-photo" href="{{ product.url }}" aria-label="Szczegóły: {{ product.name }}">{% if product.image %}<img src="{{ product.image | image_url: 'w400' }}" alt="{{ product.image.alt | default: product.name }}" loading="lazy" decoding="async">{% else %}<span class="slot-label">{% render 'icon', name: 'image' %}Zdjęcie wkrótce</span>{% endif %}</a><div class="product-body"><a class="product-name" href="{{ product.url }}">{{ product.name }}</a><div class="price">{% if product.on_sale %}<del>{{ product.compare_at | money: product.currency }}</del>{% endif %}{% if product.has_range %}od {% endif %}{{ product.price | money: product.currency }}</div>{% render 'omnibus', product: product, classes: 'll-omnibus' %}<div class="product-actions"><button type="button" data-shop-fav="{{ product.id }}" aria-label="Ulubione: {{ product.name }}" aria-pressed="false">{% render 'icon', name: 'heart' %}<span>Do ulubionych</span></button>{% if product.available %}<button type="button" class="add" data-shop-add data-product="{{ product.slug }}" aria-label="Dodaj do koszyka: {{ product.name }}">{% render 'icon', name: 'cart' %}</button>{% else %}<span class="ll-unavailable">Niedostępny</span>{% endif %}</div></div></article>

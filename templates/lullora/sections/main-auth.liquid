{%- assign terms_url = 'legal:TERMS' | link -%}
{%- assign field = 'field' -%}
{%- assign gold = 'btn' -%}
{%- assign card = 'stack shop-form' -%}
{%- case auth.view -%}
{%- when 'register' -%}{%- assign auth_title = 'Utwórz konto' -%}
{%- when 'verify' -%}{%- assign auth_title = 'Potwierdź konto' -%}
{%- when 'reset_request' -%}{%- assign auth_title = 'Odzyskaj hasło' -%}
{%- when 'reset' -%}{%- assign auth_title = 'Ustaw nowe hasło' -%}
{%- else -%}{%- assign auth_title = section.settings.login_title -%}
{%- endcase %}
{% render 'page-head', title: auth_title, kicker: 'Moje konto' %}
<div id="pageBody">
<div class="account-visual">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: 'w1200' }}" alt="{{ section.settings.image_alt }}"{{ section | edit: 'image' }}>{% endif %}<div class="account-caption"><strong{{ section | edit: 'caption_title' }}>{{ section.settings.caption_title }}</strong><p{{ section | edit: 'caption_text' }}>{{ section.settings.caption_text }}</p></div></div>
<div class="account-form">
{% render 'shop-auth-error', auth: auth %}
{%- if auth.view == 'login' or auth.view == 'register' %}
<div class="shop-tabs"><a class="{% if auth.view == 'login' %}active{% endif %}" href="/konto/logowanie"{% if auth.view == 'login' %} aria-current="page"{% endif %}>Logowanie</a><a class="{% if auth.view == 'register' %}active{% endif %}" href="/konto/rejestracja"{% if auth.view == 'register' %} aria-current="page"{% endif %}>Rejestracja</a></div>
{%- endif %}
{%- case auth.view %}
{%- when 'login' %}
<p class="mb-6 shop-muted">Konto pozwala śledzić zamówienia, zapisać adresy i oceniać kupione produkty.</p>
<form class="{{ card }}" data-shop-form="login">
<label class="grid gap-2">E-mail<input name="email" type="email" required autocomplete="email" class="{{ field }}"></label>
<label class="grid gap-2">Hasło<input name="password" type="password" required autocomplete="current-password" class="{{ field }}"></label>
<p class="checkout-error text-sm font-bold" role="alert" data-shop-error></p>
<button class="{{ gold }}" type="submit" data-busy-label="Logowanie…">Zaloguj się</button>
<a href="/konto/reset" class="text-center text-sm underline">Nie pamiętasz hasła?</a>
<a href="/produkty" class="text-center text-sm shop-muted">Kontynuuj jako gość</a>
</form>
{% render 'shop-google-button', auth: auth, btn_class: 'google-btn', or_class: 'shop-divider', position: 'after', terms: terms_url %}
{%- when 'register' %}
<form class="{{ card }}" data-shop-form="register">
<div class="checkout-grid">
<label class="grid gap-2">Imię<input name="firstName" autocomplete="given-name" maxlength="100" class="{{ field }}"></label>
<label class="grid gap-2">Nazwisko<input name="lastName" autocomplete="family-name" maxlength="100" class="{{ field }}"></label>
</div>
<label class="grid gap-2">E-mail<input name="email" type="email" required autocomplete="email" class="{{ field }}"></label>
<label class="grid gap-2">Hasło<input name="password" type="password" required minlength="10" autocomplete="new-password" class="{{ field }}" aria-describedby="pass-hint"><span id="pass-hint" class="text-xs shop-muted">Co najmniej 10 znaków. Najlepiej kilka słów.</span></label>
<label class="flex cursor-pointer items-start gap-2 text-xs leading-relaxed"><input type="checkbox" name="termsAccepted" class="mt-0.5 size-4 shrink-0 ll-check"><span>Akceptuję <a class="font-bold underline" href="{{ 'legal:TERMS' | link }}" target="_blank" rel="noopener">regulamin sklepu</a>.</span></label>
{%- if auth.captcha_site_key %}<div data-shop-captcha="{{ auth.captcha_site_key }}"></div>{% endif %}
<p class="checkout-error text-sm font-bold" role="alert" data-shop-error></p>
<button class="{{ gold }}" type="submit" data-busy-label="Zakładanie konta…">Załóż konto</button>
</form>
{% render 'shop-google-button', auth: auth, btn_class: 'google-btn', or_class: 'shop-divider', position: 'after', label: 'Zarejestruj się przez Google', terms: terms_url %}
<div class="{{ card }}" role="status" tabindex="-1" hidden data-shop-done><p class="ll-strong">Sprawdź skrzynkę e-mail</p><p class="shop-muted">Wysłaliśmy link do potwierdzenia konta. Po kliknięciu podasz hasło ustawione przed chwilą.</p></div>
{%- when 'verify' %}
<div data-shop-needs-link-token>
<p class="mb-6 shop-muted">Dla bezpieczeństwa wpisz hasło ustawione przy zakładaniu konta.</p>
<form class="{{ card }}" data-shop-form="verify">
<label class="grid gap-2">Hasło<input name="password" type="password" required autocomplete="current-password" class="{{ field }}"></label>
<p class="checkout-error text-sm font-bold" role="alert" data-shop-error></p>
<button class="{{ gold }}" type="submit" data-busy-label="Potwierdzanie…">Potwierdź i zaloguj</button>
</form>
<p class="{{ card }}" hidden data-shop-link-missing>Link jest niepełny. Otwórz go ponownie z wiadomości e-mail.</p>
<p class="mt-6 text-sm shop-muted">Nie zakładałeś(-aś) konta? Zamknij tę stronę — bez hasła konto nie zostanie aktywowane.</p>
</div>
{%- when 'reset_request' %}
<form class="{{ card }}" data-shop-form="reset-request">
<label class="grid gap-2">E-mail<input name="email" type="email" required autocomplete="email" class="{{ field }}"></label>
{%- if auth.captcha_site_key %}<div data-shop-captcha="{{ auth.captcha_site_key }}"></div>{% endif %}
<p class="checkout-error text-sm font-bold" role="alert" data-shop-error></p>
<button class="{{ gold }}" type="submit" data-busy-label="Wysyłanie…">Wyślij link</button>
</form>
<p class="{{ card }}" role="status" tabindex="-1" hidden data-shop-done>Jeśli konto z tym adresem istnieje, wysłaliśmy na nie link do ustawienia nowego hasła (ważny 1 godzinę).</p>
<p class="mt-6 text-center text-sm"><a href="/konto/logowanie" class="underline">Wróć do logowania</a></p>
{%- when 'reset' %}
<div data-shop-needs-link-token>
<form class="{{ card }}" data-shop-form="reset">
<label class="grid gap-2">Nowe hasło<input name="password" type="password" required minlength="10" autocomplete="new-password" class="{{ field }}"></label>
<p class="checkout-error text-sm font-bold" role="alert" data-shop-error></p>
<button class="{{ gold }}" type="submit" data-busy-label="Zapisywanie…">Zapisz hasło</button>
</form>
<div class="{{ card }}" role="status" tabindex="-1" hidden data-shop-done><p>Hasło zostało zmienione. Wylogowaliśmy Cię ze wszystkich urządzeń.</p><a href="/konto/logowanie" class="{{ gold }} text-center">Zaloguj się</a></div>
<p class="{{ card }}" hidden data-shop-link-missing>Link jest niepełny. <a href="/konto/reset" class="font-bold underline">Poproś o nowy</a>.</p>
</div>
{%- endcase %}
</div>
</div>

{% schema %}
{
  "name": "Logowanie i konto",
  "settings": [ { "id": "login_title", "type": "text", "label": "Tytuł logowania", "default": "Witaj ponownie", "max": 40 },
    { "id": "image", "type": "image", "label": "Zdjęcie obok formularza", "default": "asset:about-1.webp" },
    { "id": "image_alt", "type": "text", "label": "Opis zdjęcia", "default": "Maluch w domowym otoczeniu", "max": 160 },
    { "id": "caption_title", "type": "text", "label": "Napis na zdjęciu", "default": "Małe chwile. Wielka troska.", "max": 60 },
    { "id": "caption_text", "type": "text", "label": "Tekst na zdjęciu", "default": "Twoje konto w jednym miejscu.", "max": 120 } ]
}
{% endschema %}

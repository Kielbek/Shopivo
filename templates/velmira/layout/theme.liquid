<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
{{ content_for_header }}
</head>
<body>
{{ header_group }}
<div class="shell">
{%- if page_type == 'index' -%}
<div id="homeView">
{{ content_for_layout }}
</div>
{%- else -%}
<div id="otherView">
<div class="page" id="page">
{{ content_for_layout }}
</div>
</div>
{%- endif -%}
{{ footer_group }}
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden data-shop-toast></div>
{{ content_for_footer }}
</body>
</html>

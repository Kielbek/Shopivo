{%- assign field = 'field' -%}
{%- assign gold = 'pill' -%}
{% render 'page-title', text: section.settings.title %}
{%- if cart.lines.size == 0 %}
{% render 'empty', text: 'Twój koszyk jest pusty.' %}
{%- else %}
{%- assign c = checkout.customer -%}
<form class="vm-checkout" data-shop-checkout novalidate>
<div class="grid stack-6">
<fieldset class="vm-card grid gap-5">
<legend class="checkout-legend">Dane kontaktowe</legend>
{%- if c %}<p class="text-sm vm-muted">Uzupełniliśmy dane z Twojego konta ({{ c.email }}). Możesz je zmienić dla tego zamówienia.</p>
{%- else %}<p class="text-sm vm-muted">Masz konto? <a class="font-bold underline" href="/konto/logowanie?powrot=/zamowienie">Zaloguj się</a>, aby uzupełnić dane i śledzić zamówienie.</p>{% endif %}
<div class="checkout-grid">
<label class="grid gap-2">E-mail<input name="email" type="email" autocomplete="email" required maxlength="254" value="{{ c.email }}" class="{{ field }}"></label>
<label class="grid gap-2">Telefon<input name="phone" type="tel" autocomplete="tel" maxlength="30" value="{{ c.phone }}" class="{{ field }}"></label>
<label class="grid gap-2">Imię<input name="firstName" autocomplete="given-name" required maxlength="100" value="{{ c.first_name }}" class="{{ field }}"></label>
<label class="grid gap-2">Nazwisko<input name="lastName" autocomplete="family-name" required maxlength="100" value="{{ c.last_name }}" class="{{ field }}"></label>
</div>
</fieldset>
{%- if checkout.shipping_methods.size > 0 %}
<fieldset class="vm-card grid gap-5" data-shop-needs-shipping>
<legend class="checkout-legend">Adres dostawy</legend>
<label class="grid gap-2">Ulica i numer<input name="line1" autocomplete="address-line1" required maxlength="200" value="{{ c.line1 }}" class="{{ field }}"></label>
<div class="checkout-grid checkout-grid-postal">
<label class="grid gap-2">Kod pocztowy<input name="postalCode" autocomplete="postal-code" required placeholder="00-000" maxlength="6" pattern="\d{2}-\d{3}" value="{{ c.postal_code }}" class="{{ field }}"></label>
<label class="grid gap-2">Miejscowość<input name="city" autocomplete="address-level2" required maxlength="100" value="{{ c.city }}" class="{{ field }}"></label>
</div>
</fieldset>
<fieldset class="vm-card grid gap-3">
<legend class="checkout-legend">Dostawa</legend>
{%- for m in checkout.shipping_methods %}
<label class="checkout-choice"><input type="radio" name="shippingMethodId" value="{{ m.id }}" required data-price="{{ m.price }}" data-free-from="{{ m.free_from }}"{% if m.pickup_point %} data-pickup{% endif %}{% if forloop.first %} checked{% endif %}><span class="checkout-choice-text"><strong>{{ m.name }}</strong>{% if m.description != blank %}<span class="checkout-muted">{{ m.description }}</span>{% endif %}</span><span class="checkout-price" data-shop-shipping-price>{{ m.price | money: cart.currency }}</span></label>
{%- if m.pickup_point %}
<div class="checkout-pickup" data-shop-pickup="{{ m.id }}" hidden>
<p class="font-bold">Wybierz paczkomat</p>
<div class="checkout-pickup-search"><label class="sr-only" for="pp-q-{{ m.id }}">Kod pocztowy lub miasto</label><input id="pp-q-{{ m.id }}" type="search" placeholder="Kod pocztowy lub miasto, np. 30-001" maxlength="60" class="{{ field }}" data-shop-pickup-query><button type="button" class="{{ gold }}" data-shop-pickup-search>Szukaj</button></div>
<ul class="checkout-pickup-list" aria-label="Paczkomaty" data-shop-pickup-results></ul>
<label class="grid gap-2 text-sm">…albo wpisz kod paczkomatu<input type="text" maxlength="12" placeholder="np. KRA010" class="{{ field }} checkout-upper" data-shop-pickup-code></label>
<p class="text-sm" role="status" aria-live="polite" data-shop-pickup-status></p>
</div>
{%- endif %}
{%- endfor %}
</fieldset>
{%- endif %}
<fieldset class="vm-card grid gap-3">
<legend class="checkout-legend">Płatność</legend>
{%- for p in checkout.payment_methods %}
<label class="checkout-choice"><input type="radio" name="paymentMethod" value="{{ p.method }}" required data-fee="{{ p.fee }}"{% if forloop.first %} checked{% endif %}><span class="checkout-choice-text"><strong>{{ p.label }}</strong></span>{% if p.fee > 0 %}<span class="checkout-price">+ {{ p.fee | money: cart.currency }}</span>{% endif %}</label>
{%- else %}
<p class="text-sm vm-muted">Sklep nie ma jeszcze metod płatności.</p>
{%- endfor %}
</fieldset>
<fieldset class="vm-card grid gap-5">
<legend class="checkout-legend">Faktura i uwagi</legend>
<label class="flex cursor-pointer items-start gap-2 text-sm"><input type="checkbox" name="invoice" class="mt-0.5 size-4 shrink-0 vm-check" data-shop-toggle="invoice">Chcę fakturę na firmę</label>
<div class="checkout-grid" data-shop-when="invoice" hidden>
<label class="grid gap-2">Nazwa firmy<input name="companyName" autocomplete="organization" maxlength="200" class="{{ field }}"></label>
<label class="grid gap-2">NIP<input name="taxId" inputmode="numeric" maxlength="13" class="{{ field }}"></label>
</div>
<label class="grid gap-2">Uwagi do zamówienia<textarea name="customerNote" maxlength="1000" rows="3" class="{{ field }}"></textarea></label>
</fieldset>
</div>
<aside class="vm-card vm-summary checkout-summary">
<h2 class="vm-h2">Podsumowanie</h2>
<ul class="grid gap-2 text-sm">
{%- for line in cart.lines %}<li class="flex justify-between gap-3"><span>{{ line.quantity }} × {{ line.name }}{% if line.variant_title != blank and line.variant_title != line.name %} ({{ line.variant_title }}){% endif %}</span><strong>{{ line.line_total | money: cart.currency }}</strong></li>{% endfor %}
</ul>
<div class="mt-5 grid gap-2 vm-rule pt-5 text-sm" data-subtotal="{{ cart.subtotal }}" data-currency="{{ cart.currency }}" data-shop-totals>
<div class="flex justify-between"><span>Produkty</span><strong>{{ cart.subtotal | money: cart.currency }}</strong></div>
{%- if checkout.shipping_methods.size > 0 %}<div class="flex justify-between"><span>Dostawa</span><span data-shop-total="shipping">—</span></div>{% endif %}
<div class="flex justify-between" data-shop-fee-row hidden><span>Opłata za pobranie</span><span data-shop-total="fee"></span></div>
<div class="mt-3 flex justify-between vm-rule pt-pad-4 vm-total"><span>Do zapłaty</span><span data-shop-total="total">{{ cart.subtotal | money: cart.currency }}</span></div>
</div>
<div class="mt-6 grid gap-3 text-xs leading-relaxed">
<label class="flex cursor-pointer items-start gap-2"><input type="checkbox" name="termsAccepted" required class="mt-0.5 size-4 shrink-0 vm-check"><span>Akceptuję <a class="font-bold underline" href="{{ 'legal:TERMS' | link }}" target="_blank" rel="noopener">regulamin sklepu</a> i zapoznałem(-am) się z informacją o prawie odstąpienia od umowy. Dane przetwarzamy zgodnie z <a class="font-bold underline" href="{{ 'legal:PRIVACY' | link }}" target="_blank" rel="noopener">polityką prywatności</a>.</span></label>
<label class="flex cursor-pointer items-start gap-2"><input type="checkbox" name="marketingConsent" class="mt-0.5 size-4 shrink-0 vm-check"><span>Chcę otrzymywać informacje o nowościach i promocjach e-mailem (zgodę możesz wycofać w każdej chwili).</span></label>
</div>
{%- if checkout.captcha_site_key %}<div class="mt-5" data-shop-captcha="{{ checkout.captcha_site_key }}"></div>{% endif %}
<p class="checkout-error mt-4 text-sm font-bold" role="alert" data-shop-error></p>
<button type="submit" class="mt-6 pill vm-block" data-busy-label="Składanie zamówienia…">Zamawiam i płacę</button>
<p class="mt-4 text-center text-xs">Kliknięcie oznacza zamówienie z obowiązkiem zapłaty.</p>
</aside>
</form>
{%- endif %}

{% schema %}
{
  "name": "Zamówienie",
  "settings": [
    { "id": "title", "type": "text", "label": "Tytuł", "default": "Zamówienie", "max": 40 }
  ]
}
{% endschema %}

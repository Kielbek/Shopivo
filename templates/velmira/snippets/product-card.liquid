{%- comment -%} Product card of the design. The tag shows the discount of reduced products. Param: product {%- endcomment -%}
<article class="product">{% if product.on_sale %}<span class="tag">−{{ product.discount }}%</span>{% endif %}<button class="heart" type="button" data-shop-fav="{{ product.id }}" aria-pressed="false" aria-label="Ulubione: {{ product.name }}">{% render 'icon', name: 'heart', px: 17 %}</button><a class="photo" href="{{ product.url }}"{% if product.color %} style="--product-color:{{ product.color }}"{% endif %}>{% if product.image %}<img src="{{ product.image | image_url: 'w400' }}" alt="{{ product.image.alt | default: product.name }}" loading="lazy" decoding="async">{% else %}<span class="vm-placeholder">Zdjęcie wkrótce</span>{% endif %}</a><div class="product-info"><a href="{{ product.url }}">{{ product.name }}</a>{% if product.summary != blank %}<p>{{ product.summary }}</p>{% endif %}<div class="product-bottom"><span class="price">{% render 'price', product: product %}</span>{% if product.available %}<button class="add" type="button" data-shop-add data-product="{{ product.slug }}" aria-label="Dodaj do koszyka: {{ product.name }}">{% render 'icon', name: 'plus', px: 18 %}</button>{% else %}<span class="tiny">Niedostępny</span>{% endif %}</div>{% render 'omnibus', product: product, classes: 'vm-omnibus' %}</div></article>

{%- for i in items -%}
{%- if i.br %}<br>{% elsif i.route %}<a href="{{ i.route }}">{{ i.text }}</a>{% elsif i.href %}<a href="{{ i.href }}" target="_blank" rel="noopener nofollow">{{ i.text }}</a>{% elsif i.bold %}<strong>{{ i.text }}</strong>{% elsif i.italic %}<em>{{ i.text }}</em>{% else %}{{ i.text }}{% endif -%}
{%- endfor -%}

<article class="product-card relative min-w-0 rounded-[24px] border border-[#eee4d8] bg-white p-2 pb-5 text-center"><a href="{{ product.url }}" class="block">{% render 'product-art', product: product, classes: 'aspect-square w-full rounded-[18px]', size: 'w400' %}<h3 class="mt-3 text-sm font-extrabold sm:text-lg">{{ product.name }}</h3><p class="product-price mt-2 text-sm font-extrabold sm:text-lg">{% render 'price', product: product, del_class: 'ml-1 text-xs font-semibold text-black/50' %}</p>{% render 'omnibus', product: product, classes: 'card-omnibus mt-1 px-2' %}</a>{% render 'fav-button', product: product %}{% if product.available %}<button type="button" data-shop-add data-product="{{ product.slug }}" class="product-add mx-1 mt-4 rounded-full bg-[#f8bf73] px-3 py-2 text-xs font-extrabold text-[#382319] sm:px-5 sm:text-sm">Do koszyka</button>{% else %}<p class="mx-1 mt-4 py-2 text-xs font-bold text-black/50 sm:text-sm">Chwilowo niedostępny</p>{% endif %}</article>

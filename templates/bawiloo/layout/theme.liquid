<!DOCTYPE html>
<html class="scroll-smooth" lang="pl">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
{{ content_for_header }}
</head>
<body class="m-0 bg-white font-['Nunito_Sans',Arial,sans-serif] text-[#151513] antialiased">
<main class="w-full min-h-screen m-0 p-0 bg-white" id="store">
{{ header_group }}
{%- if page_type == 'index' -%}
<div id="homeView">
{{ content_for_layout }}
</div>
{%- else -%}
<section class="min-h-[65vh] bg-white px-4 py-10 text-[#151513] sm:px-[6%] sm:py-16" id="pageView">
{{ content_for_layout }}
</section>
{%- endif -%}
{{ footer_group }}
<div aria-live="polite" class="fixed bottom-5 right-5 z-50 max-w-[90vw] rounded-xl bg-[#f8bf73] px-5 py-3 font-bold text-[#151513] shadow-xl" hidden="" id="toast" role="status" data-shop-toast></div>
</main>
{{ content_for_footer }}
</body>
</html>

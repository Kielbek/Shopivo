{% render 'page-title', text: section.settings.title %}
{%- if blog.posts.size > 0 %}
<div class="grid gap-5 blog-grid xl:grid-cols-3">
{%- for post in blog.posts %}
<article class="product-card rounded-[24px] border border-[#eee4d8] bg-white p-6"><a href="{{ post.url }}" class="block"><p class="text-sm text-[#6b625a]">{{ post.published_at | date: '%d.%m.%Y' }}</p><h2 class="mt-2 text-xl font-extrabold">{{ post.title }}</h2>{% if post.excerpt != blank %}<p class="mt-3 text-sm leading-relaxed text-black/65">{{ post.excerpt }}</p>{% endif %}<span class="mt-4 inline-block text-sm font-bold text-[#92520d]">Czytaj dalej →</span></a></article>
{%- endfor %}
</div>
{%- if blog.total_pages > 1 %}
<nav class="mt-10 flex items-center justify-center gap-3 text-sm font-bold" aria-label="Strony bloga">
{%- if blog.prev_url %}<a href="{{ blog.prev_url }}" rel="prev" class="rounded-full border border-[#dfcbb5] bg-white px-5 py-2 hover:bg-[#fff0d6]">← Nowsze</a>{% endif %}
<span class="text-[#6b625a]">Strona {{ blog.page }} z {{ blog.total_pages }}</span>
{%- if blog.next_url %}<a href="{{ blog.next_url }}" rel="next" class="rounded-full border border-[#dfcbb5] bg-white px-5 py-2 hover:bg-[#fff0d6]">Starsze →</a>{% endif %}
</nav>
{%- endif %}
{%- else %}
{% render 'empty', text: 'Wkrótce pojawią się tu pierwsze wpisy.', link: '/', label: 'Wróć do sklepu' %}
{%- endif %}

{% schema %}
{
  "name": "Lista wpisów bloga",
  "settings": [ { "id": "title", "type": "text", "label": "Tytuł", "default": "Blog", "max": 40 } ]
}
{% endschema %}

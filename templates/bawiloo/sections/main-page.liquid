<article class="mx-auto narrow-3xl">
{%- if entry.kind == 'post' %}<nav class="mb-8 text-sm text-[#6b625a]" aria-label="Ścieżka"><a href="/">Start</a> / <a href="/blog">Blog</a></nav>{% endif %}
{% render 'page-title', text: entry.title %}
{%- if entry.kind == 'post' and entry.published_at %}<p class="mb-8 text-sm text-[#6b625a]">{{ entry.published_at | date: '%d.%m.%Y' }}</p>{% endif %}
{% render 'rich-text', blocks: entry.blocks %}
</article>

{% schema %}
{ "name": "Strona z treścią", "settings": [] }
{% endschema %}

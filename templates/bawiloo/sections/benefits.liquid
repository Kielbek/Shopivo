<section aria-label="{{ section.settings.label }}" class="grid grid-cols-2 gap-3 px-[6%] pb-20 pt-10 md:grid-cols-4 lg:gap-5 lg:pb-32 lg:pt-16">
{%- for block in section.blocks %}
<article class="rounded-2xl border border-[#f0e2d0] bg-[#fffaf4] px-3 py-5 text-center shadow-[0_6px_20px_rgba(99,64,26,0.055)] sm:px-5"{{ block | block_attrs }}>
<div aria-hidden="true" class="mx-auto flex items-center justify-center">
{% render 'benefit-icon', icon: block.settings.icon, uid: block.id %}
</div>
<h3 class="mt-4 text-xs font-bold tracking-[0.08em] text-[#151513] sm:text-sm"{{ block | edit: 'title' }}>{{ block.settings.title }}</h3>
<p class="mt-2 text-[11px] leading-snug text-black/65 sm:text-xs"{{ block | edit: 'text' }}>{{ block.settings.text }}</p>
</article>
{%- endfor %}
</section>

{% schema %}
{
  "name": "Korzyści z ikonami",
  "settings": [
    { "id": "label", "type": "text", "label": "Nazwa sekcji dla czytników ekranu", "default": "Korzyści z zakupów", "max": 60 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Korzyść",
      "settings": [
        { "id": "icon", "type": "select", "label": "Ikona", "default": "shield",
          "options": [
            { "value": "shield", "label": "Bezpieczne płatności" }, { "value": "return", "label": "Zwroty" },
            { "value": "truck", "label": "Dostawa" }, { "value": "chat", "label": "Pomoc" } ] },
        { "id": "title", "type": "text", "label": "Tytuł", "default": "KORZYŚĆ", "max": 40 },
        { "id": "text", "type": "text", "label": "Opis", "default": "", "max": 120 }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}

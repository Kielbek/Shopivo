<section id="{{ section.settings.anchor | default: 'promotions' }}" aria-labelledby="promo-title-{{ section.id }}" class="relative overflow-hidden bg-[#fff8ed] px-3 py-12 text-[#151513] sm:px-[5%] lg:py-16">
<div class="promo-heading mx-auto text-center">
{%- if section.settings.kicker != blank %}<span class="promo-kicker">✦ &nbsp; <span{{ section | edit: 'kicker' }}>{{ section.settings.kicker }}</span> &nbsp; ✦</span>{% endif %}
<h2 id="promo-title-{{ section.id }}" class="promo-title">
<span{{ section | edit: 'heading' }}>{{ section.settings.heading }}</span>
{%- if section.settings.accent != blank %}<span class="promo-accent"{{ section | edit: 'accent' }}>{{ section.settings.accent }}</span>{% endif %}
</h2>
{%- if section.settings.text != blank %}<p class="mt-3 text-sm font-bold text-[#61574f] sm:text-base"{{ section | edit: 'text' }}>{{ section.settings.text }}</p>{% endif %}
</div>
{%- assign slides = section.settings.products.items %}
<div class="young-shell" role="region" aria-roledescription="karuzela" aria-label="{{ section.settings.label }}" tabindex="0" data-promo-slider>
<button class="young-arrow" type="button" aria-label="Poprzednia zabawka" data-promo-prev>
<svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="m15 18-6-6 6-6"/>
</svg>
</button>
<div class="young-stage" data-promo-stage>
{%- for product in slides %}
<a class="young-slide no-motion" href="{{ product.url }}" style="--offset:0;--scale:.69;--visible:0" tabindex="-1"><img src="{{ product.image | image_url: 'w400' }}" alt="{{ product.name }}" draggable="false" decoding="async">{% if product.on_sale %}<span class="promo-discount">−{{ product.discount }}%</span>{% endif %}<h3>{{ product.name }}</h3><div class="young-prices"><strong>{{ product.price | money: product.currency }}</strong>{% if product.on_sale %}<del>{{ product.compare_at | money: product.currency }}</del>{% endif %}</div>{% render 'omnibus', product: product, classes: 'promo-omnibus' %}</a>
{%- endfor %}
</div>
<button class="young-arrow" type="button" aria-label="Następna zabawka" data-promo-next>
<svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="m9 18 6-6-6-6"/>
</svg>
</button>
</div>
<div class="young-dots" aria-label="Pozycja w karuzeli" data-promo-dots>
{%- for product in slides %}<button class="young-dot" type="button" aria-label="{{ product.name }}" aria-current="false" data-slide="{{ forloop.index0 }}"></button>{% endfor -%}
</div>
<p class="sr-only" aria-live="polite" data-promo-status></p>
{%- if section.settings.button_label != blank %}
<div class="mt-7 text-center">
<a href="{{ section.settings.button_url | link | default: section.settings.products.url }}" class="inline-flex rounded-full bg-[#f8bf73] px-6 py-3 text-xs font-extrabold text-[#151513] transition hover:bg-[#ffe0a6] sm:text-sm"{{ section | edit: 'button_label' }}>{{ section.settings.button_label }}</a>
</div>
{%- endif %}
</section>

{% schema %}
{
  "name": "Slider promocji",
  "settings": [
    { "id": "kicker", "type": "text", "label": "Nadtytuł", "default": "WYJĄTKOWE OFERTY", "max": 40 },
    { "id": "heading", "type": "text", "label": "Nagłówek", "default": "WIELKA RADOŚĆ,", "max": 60 },
    { "id": "accent", "type": "text", "label": "Druga linia (wyróżniona)", "default": "MAŁE CENY!", "max": 60 },
    { "id": "text", "type": "text", "label": "Opis", "default": "Więcej zabawy. Więcej uśmiechu. Mniej wydatków.", "max": 160 },
    { "id": "products", "type": "product_list", "label": "Produkty w sliderze", "default": { "source": "sale", "count": 5 } },
    { "id": "label", "type": "text", "label": "Nazwa slidera dla czytników ekranu", "default": "Zabawki w promocji", "max": 60 },
    { "id": "button_label", "type": "text", "label": "Tekst przycisku", "default": "ZOBACZ WSZYSTKIE PROMOCJE", "max": 40 },
    { "id": "button_url", "type": "url", "label": "Link przycisku", "default": "", "info": "Puste pole: lista tych produktów w sklepie." },
    { "id": "anchor", "type": "text", "label": "Kotwica (do linków w menu)", "default": "promotions", "max": 30 }
  ]
}
{% endschema %}

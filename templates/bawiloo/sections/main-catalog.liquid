{%- assign field = 'store-field w-full rounded-xl border border-[#e7ddd0] bg-white px-4 py-3 text-[#382319]' -%}
{%- if catalog.sale -%}{%- assign heading = section.settings.sale_title -%}
{%- elsif catalog.category_name -%}{%- assign heading = catalog.category_name -%}
{%- elsif catalog.q != blank -%}{%- assign heading = 'Wyniki wyszukiwania' -%}
{%- else -%}{%- assign heading = section.settings.title -%}{%- endif -%}
{% render 'page-title', text: heading %}
<form action="/produkty" method="get" class="mb-8 grid gap-3 sm:grid-cols-[1fr_auto_auto]" role="search" data-shop-filter>
{%- if catalog.sale %}<input type="hidden" name="promocje" value="tak">{% endif %}
<input name="q" type="search" value="{{ catalog.q }}" placeholder="{{ section.settings.search_placeholder }}" aria-label="{{ section.settings.search_placeholder }}" class="{{ field }}" maxlength="100">
<select name="kategoria" aria-label="Kategoria" class="{{ field }}"><option value="">Wszystkie kategorie</option>{% for c in shop.categories %}<option value="{{ c.slug }}"{% if c.slug == catalog.category %} selected{% endif %}>{{ c.name }}</option>{% endfor %}</select>
<select name="sort" aria-label="Sortuj produkty" class="{{ field }}"><option value="">Polecane</option><option value="PRICE_ASC"{% if catalog.sort == 'PRICE_ASC' %} selected{% endif %}>Cena: od najniższej</option><option value="PRICE_DESC"{% if catalog.sort == 'PRICE_DESC' %} selected{% endif %}>Cena: od najwyższej</option><option value="NAME"{% if catalog.sort == 'NAME' %} selected{% endif %}>Nazwa A–Z</option></select>
<noscript><button type="submit" class="rounded-full bg-[#f8bf73] px-5 py-3 text-sm font-extrabold text-[#151513]">Pokaż</button></noscript>
</form>
<div data-shop-region="results">
<p class="mb-4 text-sm text-[#6b625a]" aria-live="polite">Znaleziono: {{ catalog.total }}</p>
{%- if catalog.items.size > 0 %}
{% render 'product-grid', products: catalog.items %}
{%- if catalog.total_pages > 1 %}
<nav class="mt-10 flex items-center justify-center gap-3 text-sm font-bold" aria-label="Strony wyników">
{%- if catalog.prev_url %}<a href="{{ catalog.prev_url }}" rel="prev" class="rounded-full border border-[#dfcbb5] bg-white px-5 py-2 hover:bg-[#fff0d6]">← Poprzednia</a>{% endif %}
<span class="text-[#6b625a]">Strona {{ catalog.page }} z {{ catalog.total_pages }}</span>
{%- if catalog.next_url %}<a href="{{ catalog.next_url }}" rel="next" class="rounded-full border border-[#dfcbb5] bg-white px-5 py-2 hover:bg-[#fff0d6]">Następna →</a>{% endif %}
</nav>
{%- endif %}
{%- else %}
{% render 'empty', text: section.settings.empty_text, link: '/produkty', label: 'Wszystkie zabawki' %}
{%- endif %}
</div>

{% schema %}
{
  "name": "Lista produktów",
  "settings": [
    { "id": "title", "type": "text", "label": "Tytuł listy wszystkich produktów", "default": "Odkryj nasze zabawki", "max": 60 },
    { "id": "sale_title", "type": "text", "label": "Tytuł listy promocji", "default": "Promocje", "max": 60 },
    { "id": "search_placeholder", "type": "text", "label": "Podpowiedź w wyszukiwarce", "default": "Szukaj zabawek…", "max": 40 },
    { "id": "empty_text", "type": "text", "label": "Tekst, gdy nic nie znaleziono", "default": "Nie znaleziono zabawek pasujących do wyszukiwania.", "max": 120 }
  ]
}
{% endschema %}

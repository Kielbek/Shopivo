<footer class="border-t border-[#eee2d5] bg-[#fff8ee] px-5 pb-6 pt-14 sm:px-[6%]" id="contact">
<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
<div>
<a class="font-['Fredoka',sans-serif] text-4xl font-semibold text-[#92520d]" href="/">{{ shop.name }}</a>
{%- if section.settings.text != blank %}<p class="mt-4 max-w-xs text-sm text-black/60"{{ section | edit: 'text' }}>{{ section.settings.text }}</p>{% endif %}
</div>
{%- for block in section.blocks %}
{%- if block.type == 'links' %}
<div{{ block | block_attrs }}>
<h2 class="font-extrabold"{{ block | edit: 'title' }}>{{ block.settings.title }}</h2>
<div class="mt-4 grid gap-2 text-sm text-black/65">
{%- for link in block.settings.links %}
<a href="{{ link.url | link }}">{{ link.label }}</a>
{%- endfor %}
</div>
</div>
{%- elsif block.type == 'help' %}
<div{{ block | block_attrs }}>
<h2 class="font-extrabold"{{ block | edit: 'title' }}>{{ block.settings.title }}</h2>
<p class="mt-4 text-sm text-black/65"{{ block | edit: 'text' }}>{{ block.settings.text }}</p>
{%- if block.settings.button_label != blank %}<a class="mt-4 inline-block rounded-full border border-[#dca458] px-5 py-2 text-sm font-bold text-[#92520d]" href="{{ block.settings.button_url | link }}"{{ block | edit: 'button_label' }}>{{ block.settings.button_label }}</a>{% endif %}
</div>
{%- endif %}
{%- endfor %}
</div>
<div class="mt-12 flex flex-wrap justify-between gap-3 border-t border-black/10 pt-5 text-xs text-black/50">
<span>© {{ 'now' | date: '%Y' }} {{ shop.name }}.{% if section.settings.copyright != blank %} {{ section.settings.copyright }}{% endif %}</span>
<span>Polski · {{ shop.currency }}</span>
</div>
</footer>

{% schema %}
{
  "name": "Stopka",
  "settings": [
    { "id": "text", "type": "textarea", "label": "Tekst pod logo", "default": "Każda zabawka to nowa radość. Trochę więcej wyobraźni, jeszcze więcej zabawy.", "max": 300 },
    { "id": "copyright", "type": "text", "label": "Dopisek przy prawach autorskich", "default": "", "max": 80 }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Kolumna z linkami",
      "settings": [
        { "id": "title", "type": "text", "label": "Tytuł", "default": "SKLEP", "max": 40 },
        { "id": "links", "type": "link_list", "label": "Linki", "default": [], "max": 8 }
      ]
    },
    {
      "type": "help",
      "name": "Kolumna z tekstem i przyciskiem",
      "settings": [
        { "id": "title", "type": "text", "label": "Tytuł", "default": "POTRZEBUJESZ POMOCY?", "max": 40 },
        { "id": "text", "type": "textarea", "label": "Tekst", "default": "", "max": 300 },
        { "id": "button_label", "type": "text", "label": "Tekst przycisku", "default": "O nas", "max": 30 },
        { "id": "button_url", "type": "url", "label": "Link przycisku", "default": "/#about" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}

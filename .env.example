# Copy to .env for local overrides. Never commit real secrets.
SHOPIVO_DB_URL=jdbc:postgresql://localhost:5432/shopivo
SHOPIVO_DB_APP_USER=shopivo_app
SHOPIVO_DB_APP_PASSWORD=shopivo_app_dev
SHOPIVO_DB_MIGRATION_USER=shopivo_owner
SHOPIVO_DB_MIGRATION_PASSWORD=shopivo_owner_dev
SHOPIVO_REDIS_URL=redis://localhost:6379
SHOPIVO_PLATFORM_DOMAIN=shopivo.localhost
SHOPIVO_APP_URL=http://localhost:4200
SHOPIVO_ADMIN_URL=http://localhost:4300
# Generate with: openssl rand -base64 32
SHOPIVO_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
SHOPIVO_ENCRYPTION_ACTIVE_KEY=1
SHOPIVO_COOKIE_SECURE=false
